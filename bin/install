#!/bin/sh
# Builds the Arch packages from this checkout with makepkg and installs them,
# so limgen shows up in the app launcher: limgen and its Vulkan engine, and
# with LIMGEN_ENGINES="vulkan cuda" the CUDA engine too (which needs the cuda
# package to build). Arguments go to makepkg.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT/pkgbuild"
LIMGEN_SOURCE=local exec makepkg -fsi "$@"
