#!/usr/bin/env bash
# Turns blind ratings back into scores per run: joins the ratings.tsv saved
# from the page bench/sheet made with that page's key.tsv, and prints the mean
# quality and theme fit of each run.
#
# Usage: bench/score <ratings.tsv> [key.tsv]
#   key.tsv defaults to build/bench/sheets/key.tsv. A mean with no scores
#   yet shows as "-"; n is the number of images rated.
#
# Both files start with "# sheet <id>". Letters are shuffled anew for every
# sheet, so ratings are scored only against the key of the same sheet; a
# mismatch or a missing id is an error (exit 1).
#
# LIMGEN_BENCH_OUT replaces build/bench in that default (used by tests).
set -euo pipefail

[[ $# -ge 1 ]] || { echo "usage: bench/score <ratings.tsv> [key.tsv]" >&2; exit 2; }
root=$(cd "$(dirname "$0")/.." && pwd)
key=${2:-${LIMGEN_BENCH_OUT:-$root/build/bench}/sheets/key.tsv}

sheet_of() { sed -n '1s/^# sheet \([0-9a-f]\{1,\}\)$/\1/p' "$1"; }
key_sheet=$(sheet_of "$key")
ratings_sheet=$(sheet_of "$1")
if [[ -z $key_sheet || $key_sheet != "$ratings_sheet" ]]; then
  echo "bench/score: $1 is from sheet '${ratings_sheet:-none}' but $key is from sheet '${key_sheet:-none}'" >&2
  exit 1
fi

printf '%-36s %8s %10s %4s\n' run quality 'theme fit' n
awk -F'\t' '
  /^#/ || $1 == "prompt" { next }
  NR == FNR { run[$1 FS $2] = $3; next }
  ($1 FS $2) in run {
    r = run[$1 FS $2]
    sum[r FS $3] += $4; n[r FS $3]++; runs[r] = 1
    if (!(($1 FS $2) in seen)) { seen[$1 FS $2] = 1; images[r]++ }
  }
  # A sheet saved halfway can lack one kind of score for a run; its mean is
  # shown as "-" rather than divided by zero. n counts the images rated.
  function mean(r, kind) {
    return n[r FS kind] ? sprintf("%.2f", sum[r FS kind] / n[r FS kind]) : "-"
  }
  END {
    for (r in runs)
      printf "%-36s %8s %10s %4d\n", r, mean(r, "quality"), mean(r, "fit"), images[r]
  }' "$key" "$1" | sort
